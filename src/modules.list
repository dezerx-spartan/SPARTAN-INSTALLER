# Load order for the installer modules.
# src/main.sh sources these in a git checkout; tools/build.sh concatenates them
# (in this order) into the single-file release bundle. Paths are relative to src/.

core/globals.sh
core/util.sh
core/log.sh
core/args.sh

ui/theme.sh
ui/term.sh
ui/text.sh
ui/draw.sh
ui/logo.sh
ui/widgets.sh
ui/form.sh
ui/line.sh
ui/busy.sh
ui/progress.sh

core/task.sh
core/plan.sh

system/os.sh
system/pkg.sh
system/service.sh
system/preflight.sh
system/swap.sh
system/time.sh
system/network.sh
system/firewall.sh
system/selinux.sh

stack/php.sh
stack/ioncube.sh
stack/composer.sh
stack/nodejs.sh
stack/nginx.sh
stack/database.sh
stack/redis.sh
stack/ssl.sh

app/detect.sh
app/env.sh
app/license.sh
app/release.sh
app/options.sh
app/preserve.sh
app/build.sh
app/octane.sh
app/queue.sh
app/cron.sh
app/permissions.sh

backup/backup.sh
backup/restore.sh

flows/common.sh
flows/install.sh
flows/update.sh
flows/uninstall.sh
flows/tools.sh
flows/demo.sh
flows/main.sh
